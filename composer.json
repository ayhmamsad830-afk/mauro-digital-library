{
    
    "name": "digital-library/website",
    "description": "Bilingual (AR/EN) digital library website with a protected server-rendered page-image reader.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-gd": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": [ "app/Support/helpers.php" ]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "php tests/run.php",
        "test:browser": "node tests/browser/ui-check.js http://127.0.0.1:8000",
        "render": "php bin/console render:work --max=5",
        "lint": "find app config routes resources public bin tests database -name '*.php' -print0 | xargs -0 -n1 php -l",
        "migrate": "php bin/console migrate"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
