# ------------------------------------------------------------------
# Digital Library — environment configuration (copy to .env)
# NEVER commit .env. NEVER put secrets in frontend JavaScript.
# ------------------------------------------------------------------

APP_NAME="MAURO"
APP_NAME_AR="مُعِين خيري"
APP_NAME_EN="MAURO"
# local | staging | production
APP_ENV=production
APP_DEBUG=false
# Public base URL without trailing slash, e.g. https://library.example.com
APP_URL=http://localhost:8000
# 32+ random bytes, base64. Generate: php bin/console key:generate
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Only for split hosting layouts: absolute path of public_html
PUBLIC_PATH=

# ---------------- Design preview (DEMO data)
# Shows clearly-labelled FICTIONAL sample books so the UI can be reviewed
# before MySQL is connected. Always forced OFF when APP_ENV=production.
APP_DEMO_UI=false

# ---------------- Database (MySQL 8.0+, InnoDB, utf8mb4 / utf8mb4_unicode_ci)
# Local setup: run database/setup/mysql_create_databases.sql once as a MySQL
# administrator; it creates mauro_library_dev + mauro_library_test and the two
# dedicated accounts below (each limited to its own database).
# Leave DB_USERNAME empty to run without a database (pages show empty states).
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mauro_library_dev
DB_USERNAME=mauro_dev
# Strong random password, set locally only — never commit a real value.
DB_PASSWORD=
DB_SOCKET=
# LOCAL DEV HARNESS ONLY (refused when APP_ENV=production): to run the site on
# SQLite instead, set DB_DRIVER=sqlite and point DB_SQLITE_PATH at the file
# (create one with: php bin/console dev:sqlite <file>). Keep the path set after
# switching to MySQL: the SQLite file is the rollback copy.
DB_SQLITE_PATH=

# ---------------- MySQL integration tests (php tests/run.php MySql)
# DESTRUCTIVE: every table of the test database is dropped and re-migrated on
# each run. ALL FIVE values below are mandatory: if one is missing or empty,
# `php bin/console db:check --test` fails and the MySQL tests are SKIPPED —
# the development credentials are never used as a fallback.
# Guards (App\Support\TestDatabaseConfig): the database must be exactly
# mauro_library_test, the account must differ from DB_USERNAME, the server must
# be local (127.0.0.1 / localhost / ::1), and APP_ENV must not be production.
# There is no DB_TEST_DRIVER: integration tests always target MySQL (the SQLite
# contract tests use an in-memory database and need no configuration).
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_DATABASE=mauro_library_test
DB_TEST_USERNAME=mauro_test
# Strong random password, different from DB_PASSWORD — never commit a real value.
DB_TEST_PASSWORD=
# DB_TEST_SOCKET=

# ---------------- Session
SESSION_NAME=dl_session
SESSION_LIFETIME=7200
# auto = Secure cookie only when the request is HTTPS. Use true in production.
SESSION_SECURE_COOKIE=auto

# ---------------- Reverse proxy (leave as-is unless the site is behind a proxy/load balancer)
# Trust X-Forwarded-Proto for HTTPS detection (only if the proxy overwrites it).
TRUST_PROXY_HEADERS=false
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For gives the client IP (rate limits). Empty = REMOTE_ADDR.
TRUSTED_PROXIES=

# ---------------- Storage (absolute paths recommended in production;
# must be OUTSIDE the web document root)
STORAGE_PATH=
PDF_MAX_UPLOAD_MB=500
COVER_MAX_UPLOAD_MB=2

# ---------------- PDF rendering (server side)
# poppler | mutool
PDF_RENDER_ENGINE=poppler
PDFTOPPM_BINARY=pdftoppm
PDFINFO_BINARY=pdfinfo
MUTOOL_BINARY=mutool
PDF_RENDER_DPI=150
PDF_RENDER_FORMAT=webp
PDF_RENDER_QUALITY=82
PDF_THUMBNAIL_WIDTH=220
PDF_RENDER_TIMEOUT=120

# ---------------- Protected reader
READER_TOKEN_TTL=300
READER_SESSION_TTL=7200
READER_PAGES_PER_MINUTE=120
READER_THUMBS_PER_MINUTE=600
READER_SESSIONS_PER_10MIN=60
WATERMARK_ALPHA=98

# ---------------- PDF pipeline limits
PDF_PAGE_WIDTH=1400
PDF_MAX_PAGES=2000
PDF_RENDER_BATCH=10
PDF_RENDER_MAX_ATTEMPTS=3
PDF_RENDER_STALE_AFTER=1800
PDF_MIN_FREE_DISK_MB=500
PDF_SYNC_MAX_PAGES=60

# ---------------- Google Identity Services
# Web application OAuth client ID (public by design). The client SECRET is not
# needed for ID-token sign-in and must never be placed in this repo or in JS.
GOOGLE_CLIENT_ID=
# Comma-separated hosted domains to restrict sign-in (optional)
GOOGLE_ALLOWED_HD=
# ---------------- E-mail (password recovery, contact notifications)
# disabled (default): nothing is sent — password recovery says it is unavailable and contact
# messages are only stored for the administrators. smtp: deliver through the server below.
# log: development only (records "logged", never the body); refused in production.
MAIL_DRIVER=disabled
MAIL_HOST=
MAIL_PORT=587
# tls = STARTTLS (587) or ssl = implicit TLS (465). Plain-text SMTP is never used.
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="MAURO"
MAIL_TIMEOUT=15
