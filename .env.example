# ------------------------------------------------------------------
# Digital Library — environment configuration (copy to .env)
# NEVER commit .env. NEVER put secrets in frontend JavaScript.
# ------------------------------------------------------------------

APP_NAME="MAURO"
APP_NAME_AR="مُعِين خيري"
APP_NAME_EN="MAURO"
# local | staging | production
APP_ENV=production
APP_DEBUG=false
# Public base URL without trailing slash, e.g. https://library.example.com
APP_URL=http://localhost:8000
# 32+ random bytes, base64. Generate: php bin/console key:generate
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Only for split hosting layouts: absolute path of public_html
PUBLIC_PATH=

# ---------------- Design preview (DEMO data)
# Shows clearly-labelled FICTIONAL sample books so the UI can be reviewed
# before MySQL is connected. Always forced OFF when APP_ENV=production.
APP_DEMO_UI=false

# ---------------- Database (MySQL 8+/MariaDB 10.6+, InnoDB, utf8mb4)
# Leave DB_USERNAME empty to run without a database (pages show empty states).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mauro_library_dev
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
# LOCAL DEV/TEST HARNESS ONLY (ignored when APP_ENV=production):
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=/absolute/path/dev.sqlite   (create with: php bin/console dev:sqlite <file>)

# MySQL integration tests (php tests/run.php). DESTRUCTIVE: the database name
# must end in _test; all its tables are dropped and re-migrated on each run.
DB_TEST_DATABASE=mauro_library_test
# DB_TEST_HOST=127.0.0.1
# DB_TEST_PORT=3306
# DB_TEST_USERNAME=
# DB_TEST_PASSWORD=

# ---------------- Session
SESSION_NAME=dl_session
SESSION_LIFETIME=7200
# auto = Secure cookie only when the request is HTTPS. Use true in production.
SESSION_SECURE_COOKIE=auto

# ---------------- Reverse proxy (leave as-is unless the site is behind a proxy/load balancer)
# Trust X-Forwarded-Proto for HTTPS detection (only if the proxy overwrites it).
TRUST_PROXY_HEADERS=false
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For gives the client IP (rate limits). Empty = REMOTE_ADDR.
TRUSTED_PROXIES=

# ---------------- Storage (absolute paths recommended in production;
# must be OUTSIDE the web document root)
STORAGE_PATH=
PDF_MAX_UPLOAD_MB=10
COVER_MAX_UPLOAD_MB=2

# ---------------- PDF rendering (server side)
# poppler | mutool
PDF_RENDER_ENGINE=poppler
PDFTOPPM_BINARY=pdftoppm
PDFINFO_BINARY=pdfinfo
MUTOOL_BINARY=mutool
PDF_RENDER_DPI=150
PDF_RENDER_FORMAT=webp
PDF_RENDER_QUALITY=82
PDF_THUMBNAIL_WIDTH=220
PDF_RENDER_TIMEOUT=120

# ---------------- Protected reader
READER_TOKEN_TTL=300
READER_SESSION_TTL=7200
READER_PAGES_PER_MINUTE=120
READER_THUMBS_PER_MINUTE=600
READER_SESSIONS_PER_10MIN=60
WATERMARK_ALPHA=98

# ---------------- PDF pipeline limits
PDF_PAGE_WIDTH=1400
PDF_MAX_PAGES=2000
PDF_RENDER_BATCH=10
PDF_RENDER_MAX_ATTEMPTS=3
PDF_RENDER_STALE_AFTER=1800
PDF_MIN_FREE_DISK_MB=500
PDF_SYNC_MAX_PAGES=60

# ---------------- Google Identity Services
# Web application OAuth client ID (public by design). The client SECRET is not
# needed for ID-token sign-in and must never be placed in this repo or in JS.
GOOGLE_CLIENT_ID=
# Comma-separated hosted domains to restrict sign-in (optional)
GOOGLE_ALLOWED_HD=
